# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# The Odds API — get a free key at https://the-odds-api.com
ODDS_API_KEY=your_api_key_here

# Stake.com credentials — used by the browser automation bettor
STAKE_EMAIL=your_email@example.com
STAKE_PASSWORD=your_password_here

# Base URL for the Stake site (change to https://stake.com if not on .co)
STAKE_BASE_URL=https://stake.com.co

# Browser session persistence — cookies/storage are saved here so login
# survives between runs. The file is created automatically on first run.
BROWSER_STATE_PATH=state/browser_session.json

# Maximum acceptable odds movement between selection and confirmation (3 = 3%).
# Bets where the odds drifted more than this are rejected automatically.
ODDS_DRIFT_TOLERANCE=0.03

# Set to "false" to watch the browser window (useful for debugging selectors).
HEADLESS=true

# COP to USD exchange rate (10 000 COP ≈ $2.50 USD at 4 000 COP/USD)
# Update this if the rate changes significantly before a run.
COP_TO_USD_RATE=0.00025

# Live pipeline settings
# Initial bankroll in COP
LIVE_BANKROLL=10000
# Kelly fraction (0.0 – 1.0). Lower = more conservative.
LIVE_KELLY_FRACTION=0.25
# Max stake per bet as fraction of bankroll
LIVE_MAX_STAKE_PCT=0.05
# Minimum EV edge required to place a bet
LIVE_EV_THRESHOLD=0.05
# Set to "true" to log bets without actually placing them
DRY_RUN=true

# Total time budget for the full benchmark in minutes (10 min per experiment × 3 = 30)
TIME_EXPERIMENT=30
